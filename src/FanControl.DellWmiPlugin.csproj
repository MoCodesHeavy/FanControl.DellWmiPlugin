<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FanControl.DellWmiPlugin</AssemblyName>
    <RootNamespace>FanControl.DellWmiPlugin</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CA1416</NoWarn>
    <Version>1.0.0</Version>
    <Description>FanControl plugin for Dell laptops whose SMM BIOS is only reachable over ACPI-WMI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- FanControl.Plugins.dll ships with FanControl; referenced for compilation only. -->
    <Reference Include="FanControl.Plugins">
      <HintPath>..\lib\FanControl.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- System.Management also ships with FanControl; referenced for compilation only. -->
    <Reference Include="System.Management">
      <HintPath>..\lib\System.Management.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
